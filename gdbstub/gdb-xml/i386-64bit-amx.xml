<!DOCTYPE feature SYSTEM "gdb-target.dtd">
<feature name="org.gnu.gdb.i386.amx">
  <!-- One uint512 value per row of a tile.  -->
  <vector id="v_ui512" type="uint512" count="16"/>

  <!-- The raw contents of the tile configuration register.  -->
  <reg name="tilecfg_raw" bitsize="512" type="uint512"/>

  <!-- The raw contents of the eight tiles, each of which is 16 rows of
       64 bytes.  -->
  <reg name="tmm0_raw" bitsize="8192" type="v_ui512"/>
  <reg name="tmm1_raw" bitsize="8192" type="v_ui512"/>
  <reg name="tmm2_raw" bitsize="8192" type="v_ui512"/>
  <reg name="tmm3_raw" bitsize="8192" type="v_ui512"/>
  <reg name="tmm4_raw" bitsize="8192" type="v_ui512"/>
  <reg name="tmm5_raw" bitsize="8192" type="v_ui512"/>
  <reg name="tmm6_raw" bitsize="8192" type="v_ui512"/>
  <reg name="tmm7_raw" bitsize="8192" type="v_ui512"/>
</feature>
